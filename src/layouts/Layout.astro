---
// Zajednički okvir svake stranice: oznake za pretraživače i deljenje, zaglavlje, sadržaj i podnožje.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Chatbot from '../components/Chatbot.astro';
import { clinic, url, type Lang, type PageKey } from '../i18n';
import { content } from '../content';
import { SITE_IS_TEST, absolute, clinicJsonLd, htmlLang, ogLocale } from '../seo';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
  // Glavna slika stranice, da je pregledač počne da učitava odmah.
  preload?: { srcset: string; sizes: string };
}

const { lang, page, title, description, preload } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = absolute(url(page, lang), Astro.site);
const ogImage = absolute(`${base}og-image.jpg`, Astro.site);
const otherLang: Lang = lang === 'sr' ? 'en' : 'sr';
const bot = content[lang].chatbot;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={SITE_IS_TEST ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="sr-Latn" href={absolute(url(page, 'sr'), Astro.site)} />
    <link rel="alternate" hreflang="en" href={absolute(url(page, 'en'), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={absolute(url(page, 'sr'), Astro.site)} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={clinic.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={content[lang].home.hero.photoAlt} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {preload && <link rel="preload" as="image" imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600&family=Source+Sans+3:wght@400;600&display=swap" />

    <script type="application/ld+json" set:html={JSON.stringify(clinicJsonLd(lang, Astro.site))} />
    <slot name="head" />
  </head>
  <body>
    <Header lang={lang} page={page} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <Chatbot lang={lang} bot={bot} />
  </body>
</html>
