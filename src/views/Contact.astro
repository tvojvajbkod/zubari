---
// Stranica Kontakt: telefon (glavni način zakazivanja), adresa, radno vreme i mapa.
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { clinic, t, type Lang } from '../i18n';
import type { Content } from '../content';

interface Props {
  lang: Lang;
  c: Content;
}

const { lang, c } = Astro.props;
const k = c.contact;
const text = t[lang];
const destination = 'Knez Mihailova, Beograd';
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(destination)}&z=16&output=embed&hl=${lang === 'sr' ? 'sr-Latn' : 'en'}`;
// Link za rutu na Google mapi (zvanični format "Maps URLs"): uvek prikazuje trenutne linije.
const routeUrl = (from: string, mode: string) =>
  `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(from)}&destination=${encodeURIComponent(destination)}&travelmode=${mode}`;
---

<Layout lang={lang} page="contact" title={k.seoTitle} description={k.description}>
  <PageIntro eyebrow={k.eyebrow} title={k.title} intro={k.intro} />

  <div class="container contact">
    <div class="details">
      <section class="call">
        <h2>{k.callTitle}</h2>
        <a class="phone" href={clinic.phoneHref}>{clinic.phone}</a>
        <p>{k.callText}</p>
        <a class="btn btn--primary" href={clinic.phoneHref}>{text.call}</a>
      </section>

      <section>
        <h2>{k.addressTitle}</h2>
        <p>{clinic.address[lang]}</p>
        <p class="muted">{k.directions}</p>
      </section>

      <section>
        <h2>{text.hoursTitle}</h2>
        {text.hours.map((line) => <p>{line}</p>)}
      </section>

      <section>
        <h2>{k.emailTitle}</h2>
        <p><a href={`mailto:${clinic.email}`}>{clinic.email}</a></p>
        <p class="muted">{k.emailText}</p>
      </section>
    </div>

    <iframe class="map" src={mapSrc} title={k.mapTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>

  <section class="container transport">
    <h2 class="transport__title">{k.transport.title}</h2>
    <p class="transport__intro">{k.transport.intro}</p>
    <ul class="routes">
      {
        k.transport.origins.map((o) => (
          <li>
            <div>
              <h3>{o.name}</h3>
              <p>{o.detail}</p>
            </div>
            <a class="route-link" href={routeUrl(o.from, o.mode)} target="_blank" rel="noopener">
              {k.transport.routeLabel} →<span class="sr-only"> ({k.transport.newTab})</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="transport__note">{k.transport.note}</p>
  </section>
</Layout>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 3rem;
    padding-top: 1rem;
  }
  .details section {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .details section:last-child {
    border-bottom: 0;
  }
  h2 {
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .details p {
    margin: 0 0 0.25rem;
  }
  .muted {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .call {
    padding: 1.75rem !important;
    border: 0 !important;
    border-radius: var(--radius);
    background: var(--bg-soft);
  }
  .phone {
    display: block;
    margin-bottom: 0.25rem;
    font-size: clamp(1.7rem, 3.5vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--primary);
    text-decoration: none;
  }
  .call .btn {
    margin-top: 1rem;
  }
  .map {
    width: 100%;
    height: 100%;
    min-height: 420px;
    border: 0;
    border-radius: calc(var(--radius) * 1.5);
  }
  .transport {
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }
  .transport__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.5vw, 2.6rem);
    font-weight: 600;
    letter-spacing: normal;
    text-transform: none;
    color: var(--ink);
  }
  .transport__intro {
    max-width: 44rem;
    margin: 0 0 2rem;
    color: var(--ink-soft);
  }
  .routes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .routes li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .routes h3 {
    margin: 0 0 0.15rem;
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .routes p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .route-link {
    flex: none;
    padding: 0.45rem 1rem;
    border: 1.5px solid var(--primary);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .route-link:hover {
    background: var(--accent-soft);
  }
  .transport__note {
    margin: 1.5rem 0 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-soft);
    color: var(--ink-soft);
  }
  @media (max-width: 850px) {
    .contact,
    .routes {
      grid-template-columns: 1fr;
    }
  }
</style>
