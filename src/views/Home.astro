---
// Početna stranica.
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CallBand from '../components/CallBand.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import RouteList from '../components/RouteList.astro';
import { clinic, t, url, type Lang } from '../i18n';
import { mapSrc } from '../location';
import { photos } from '../photos';
import type { Content } from '../content';

interface Props {
  lang: Lang;
  c: Content;
}

const { lang, c } = Astro.props;
const h = c.home;
const featured = c.services.items.slice(0, 6);
const reviews = c.reviews.items.slice(0, 3);
// Glavna slika: iste veličine kao u <Image> ispod, da bi pregledač mogao da je učita unapred.
const heroWidths = [600, 900, 1200, 1600];
const heroSizes = '(max-width: 900px) 100vw, 50vw';
const heroImg = await getImage({ src: photos.hero, widths: heroWidths, sizes: heroSizes });
---

<Layout lang={lang} page="home" title={h.seoTitle} description={h.description} preload={{ srcset: heroImg.srcSet.attribute, sizes: heroSizes }}>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <h1>
          <span class="eyebrow hero__eyebrow">{h.hero.eyebrow}</span>
          {h.hero.title}
        </h1>
        <p class="hero__lead">{h.hero.text}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={clinic.phoneHref}>{t[lang].call}: {clinic.phone}</a>
          <a class="btn btn--ghost" href={url('services', lang)}>{h.hero.secondary}</a>
        </div>
      </div>
      <div class="hero__photo">
        <Image src={photos.hero} alt={h.hero.photoAlt} widths={heroWidths} sizes={heroSizes} loading="eager" fetchpriority="high" />
      </div>
    </div>
    <div class="container">
      <ul class="trust">
        {
          h.trust.map((item) => (
            <li>
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container section why">
    <div>
      <p class="eyebrow">{h.why.eyebrow}</p>
      <h2>{h.why.title}</h2>
    </div>
    <ul class="checklist">
      {
        h.why.items.map((item) => (
          <li>
            <span class="check" aria-hidden="true">✓</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{h.services.eyebrow}</p>
          <h2>{h.services.title}</h2>
        </div>
        <a class="link-arrow" href={url('services', lang)}>{h.services.cta} →</a>
      </div>
      <ul class="services">
        {
          featured.map((s) => (
            <li>
              <a href={`${url('services', lang)}#${s.id}`}>
                <Image src={photos[s.photo]} alt={s.photoAlt} widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
                <span class="services__name">{s.name}</span>
                <span class="services__short">{s.short}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <div>
        <p class="eyebrow">{h.beforeAfter.eyebrow}</p>
        <h2>{h.beforeAfter.title}</h2>
        <p class="section-sub">{h.beforeAfter.text}</p>
      </div>
    </div>
    <div class="ba-grid">
      {
        h.beforeAfter.cases.map((item) => (
          <BeforeAfter
            photo={item.photo}
            title={item.title}
            detail={item.detail}
            before={h.beforeAfter.before}
            after={h.beforeAfter.after}
            sliderLabel={h.beforeAfter.sliderLabel}
          />
        ))
      }
    </div>
    <p class="ba-note">{h.beforeAfter.disclaimer}</p>
  </section>

  <section class="section soft">
    <div class="container about">
    <Image src={photos.konsultacija} alt={h.about.photoAlt} widths={[600, 900]} sizes="(max-width: 900px) 100vw, 50vw" />
    <div>
      <p class="eyebrow">{h.about.eyebrow}</p>
      <h2>{h.about.title}</h2>
      <p>{h.about.text}</p>
      <a class="link-arrow" href={url('team', lang)}>{h.about.cta} →</a>
    </div>
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <div>
        <p class="eyebrow">{h.reviews.eyebrow}</p>
        <h2>{h.reviews.title}</h2>
      </div>
      <a class="link-arrow" href={url('reviews', lang)}>{h.reviews.cta} →</a>
    </div>
    <div class="quotes">
      {
        reviews.map((r) => (
          <figure>
            <blockquote>{t[lang].quote[0]}{r.text}{t[lang].quote[1]}</blockquote>
            <figcaption>
              <strong>{r.name}</strong> · {r.service}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="section soft">
    <div class="container location">
      <iframe class="location__map" src={mapSrc(lang)} title={c.contact.mapTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      <div>
        <p class="eyebrow">{h.location.eyebrow}</p>
        <h2>{h.location.title}</h2>
        <p class="section-sub">{h.location.text}</p>
        <div class="location__routes">
          <RouteList transport={c.contact.transport} columns={1} />
        </div>
        <a class="link-arrow" href={url('contact', lang)}>{h.location.cta} →</a>
      </div>
    </div>
  </section>

  <CallBand lang={lang} title={h.callout.title} text={h.callout.text} />
</Layout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
    background: linear-gradient(180deg, var(--bg-soft), var(--bg) 85%);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  /* Natpis iznad naslova je deo H1 (zbog ključne reči), ali izgleda kao ranije. */
  .hero__eyebrow {
    display: block;
    margin-bottom: 0.8rem;
    font-family: var(--font-body);
    line-height: 1.65;
  }
  .hero h1 {
    margin: 0.8rem 0 1.25rem;
    font-size: clamp(2.6rem, 6vw, 4.4rem);
  }
  .hero__lead {
    max-width: 34rem;
    font-size: 1.15rem;
    color: var(--ink-soft);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero__photo {
    position: relative;
  }
  .hero__photo::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border: 1.5px solid var(--gold);
    border-radius: calc(var(--radius) * 2);
  }
  .hero__photo img {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3.4;
    object-fit: cover;
    border-radius: calc(var(--radius) * 2);
  }
  .trust {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding: 1.75rem 0;
    list-style: none;
    border-block: 1px solid var(--line);
  }
  .trust li {
    display: flex;
    flex-direction: column;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
  }
  .trust strong {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.1;
    color: var(--primary);
  }
  .trust span {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .why {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2rem 4rem;
  }
  .checklist {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .checklist li {
    display: flex;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .checklist li:first-child {
    padding-top: 0;
  }
  .check {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-weight: 700;
  }
  .checklist h3 {
    margin: 0 0 0.25rem;
    font-family: var(--font-body);
    font-size: 1.1rem;
  }
  .checklist p {
    margin: 0;
    color: var(--ink-soft);
  }

  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .services a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
  }
  .services img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 0.6rem;
    transition: transform 0.3s;
  }
  .services a:hover img {
    transform: scale(1.02);
  }
  .services__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
  }
  .services a:hover .services__name {
    color: var(--primary);
  }
  .services__short {
    color: var(--ink-soft);
  }

  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .about img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: calc(var(--radius) * 2);
  }
  .about p:not(.eyebrow) {
    color: var(--ink-soft);
    margin: 1rem 0 1.5rem;
  }

  .section-sub {
    margin: 0.75rem 0 0;
    color: var(--ink-soft);
  }
  .ba-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem 1.5rem;
  }
  .ba-note {
    margin: 2rem 0 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
    font-style: italic;
  }

  .location {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: stretch;
  }
  .location__map {
    width: 100%;
    height: 100%;
    min-height: 420px;
    border: 0;
    border-radius: calc(var(--radius) * 2);
    background: var(--bg);
  }
  .location__routes {
    margin: 1.75rem 0 1.5rem;
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .quotes figure {
    margin: 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--gold);
  }
  .quotes blockquote {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.45;
  }
  .quotes figcaption {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .hero__inner,
    .why,
    .about,
    .location {
      grid-template-columns: 1fr;
    }
    .hero__photo::before {
      inset: 0.75rem -0.5rem -0.75rem 0.75rem;
    }
    .trust {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 1.5rem;
    }
    .services,
    .quotes,
    .ba-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .services,
    .quotes,
    .ba-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
