---
// Stranica Utisci pacijenata.
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import CallBand from '../components/CallBand.astro';
import { type Lang } from '../i18n';
import type { Content } from '../content';

interface Props {
  lang: Lang;
  c: Content;
}

const { lang, c } = Astro.props;
const r = c.reviews;
---

<Layout lang={lang} page="reviews" title={r.title} description={r.description}>
  <PageIntro eyebrow={r.eyebrow} title={r.title} intro={r.intro}>
    <p class="disclaimer">{r.disclaimer}</p>
  </PageIntro>

  <div class="container quotes">
    {
      r.items.map((item) => (
        <figure>
          <p class="stars" aria-label="5/5">★★★★★</p>
          <blockquote>„{item.text}“</blockquote>
          <figcaption>
            <strong>{item.name}</strong> · {item.service}
          </figcaption>
        </figure>
      ))
    }
  </div>

  <CallBand lang={lang} title={c.home.callout.title} text={c.home.callout.text} />
</Layout>

<style>
  .disclaimer {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
    font-style: italic;
  }
  .quotes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem 4rem;
    padding-top: 1rem;
  }
  figure {
    margin: 0;
    padding-left: 1.5rem;
    border-left: 2px solid var(--gold);
  }
  .stars {
    margin: 0 0 0.5rem;
    color: var(--gold);
    letter-spacing: 0.15em;
  }
  blockquote {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1.45;
  }
  figcaption {
    color: var(--ink-soft);
  }
  @media (max-width: 800px) {
    .quotes {
      grid-template-columns: 1fr;
    }
  }
</style>
