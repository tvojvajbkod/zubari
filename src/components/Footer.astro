---
// Podnožje: kontakt, radno vreme, spisak stranica i napomena da je ordinacija izmišljena.
import { clinic, routes, t, url, type Lang, type PageKey } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const text = t[lang];
const pages = Object.keys(routes) as PageKey[];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="footer__name">{clinic.name}</p>
      <p>{clinic.address[lang]}</p>
      <p><a href={clinic.phoneHref}>{clinic.phone}</a></p>
      <p><a href={`mailto:${clinic.email}`}>{clinic.email}</a></p>
    </div>
    <div>
      <p class="footer__title">{text.hoursTitle}</p>
      {text.hours.map((line) => <p>{line}</p>)}
    </div>
    <div>
      <p class="footer__title">{text.pagesTitle}</p>
      <ul>
        {pages.map((p) => <li><a href={url(p, lang)}>{text.nav[p]}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="container footer__bottom">
    <p>© {year} {clinic.name}. {text.rights}</p>
    <p>{text.portfolioNote}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 5rem;
    background: var(--primary-deep);
    color: rgb(255 255 255 / 0.82);
    font-size: 0.95rem;
  }
  .footer a {
    color: inherit;
    text-decoration: none;
  }
  .footer a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .footer p {
    margin: 0 0 0.4rem;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    padding-block: 3rem;
  }
  .footer__name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: #fff;
  }
  .footer__title {
    color: var(--gold-light);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }
  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
  }
  .footer li {
    margin-bottom: 0.4rem;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.15);
    font-size: 0.85rem;
    color: rgb(255 255 255 / 0.6);
  }
</style>
