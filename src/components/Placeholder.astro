---
// Privremena stranica dok ne napravimo pravi sadržaj (korak 5 iz plana).
import Layout from '../layouts/Layout.astro';
import { t, type Lang, type PageKey } from '../i18n';

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const title = t[lang].nav[page];
const note = lang === 'sr' ? 'Sadržaj ove stranice uskoro stiže.' : 'Content for this page is coming soon.';
---

<Layout lang={lang} page={page} title={title} description={title}>
  <section class="container page-intro">
    <p class="eyebrow">Dental Studio Aurum</p>
    <h1>{title}</h1>
    <p>{note}</p>
  </section>
</Layout>
