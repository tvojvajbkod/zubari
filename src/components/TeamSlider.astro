---
// Sekcija "Naš tim" na Početnoj, po uzoru na petrovicdent.com:
// tamnoplava traka, naslov u dve boje, kvadratne fotografije u nizu koji se pomera strelicama,
// i plava traka sa telefonom kad se pređe mišem preko fotografije.
// Strelice se prikazuju samo kad sve fotografije ne stanu u red.
import { Image } from 'astro:assets';
import { clinic, url, type Lang } from '../i18n';
import { photos } from '../photos';
import type { Content } from '../content';

interface Props {
  lang: Lang;
  c: Content;
}

const { lang, c } = Astro.props;
const s = c.home.team;
---

<section class="team-band" aria-labelledby="home-team-title">
  <div class="container">
    <div class="team-band__head">
      <h2 id="home-team-title">{s.titleStart} <span>{s.titleEnd}</span></h2>
      <a class="team-band__more" href={url('team', lang)}>{s.cta} →</a>
    </div>

    <div class="slider" data-slider>
      <button class="slider__arrow slider__arrow--prev" type="button" aria-label={s.prev} data-slider-prev hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
      </button>
      <ul class="slider__track" data-slider-track>
        {
          c.team.members.map((m) => (
            <li class="doc">
              <div class="doc__photo">
                <Image src={photos[m.photo]} alt={`${m.name} – ${m.role}`} widths={[360, 560, 760]} sizes="(max-width: 700px) 85vw, 33vw" />
                <a class="doc__call" href={clinic.phoneHref} aria-label={`${s.call}: ${clinic.phone}`}>
                  <span class="doc__call-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" />
                    </svg>
                  </span>
                </a>
              </div>
              <h3 class="doc__name">{m.name}</h3>
              <p class="doc__role">{m.role}</p>
              <p class="doc__focus">{m.focus.join(' · ')}</p>
            </li>
          ))
        }
      </ul>
      <button class="slider__arrow slider__arrow--next" type="button" aria-label={s.next} data-slider-next hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((slider) => {
    const track = slider.querySelector<HTMLElement>('[data-slider-track]')!;
    const prev = slider.querySelector<HTMLButtonElement>('[data-slider-prev]')!;
    const next = slider.querySelector<HTMLButtonElement>('[data-slider-next]')!;
    const step = () => (track.firstElementChild as HTMLElement | null)?.getBoundingClientRect().width ?? track.clientWidth;
    const update = () => {
      const photo = track.querySelector<HTMLElement>('.doc__photo');
      if (photo) slider.style.setProperty('--arrow-top', `${photo.offsetHeight / 2}px`);
      const scrollable = track.scrollWidth > track.clientWidth + 2;
      prev.hidden = next.hidden = !scrollable;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .team-band {
    --sky: #8cc7ef; /* svetloplava za drugu reč naslova i ime pri prelasku mišem (kontrast 6:1) */
    padding-block: clamp(3.5rem, 8vw, 6rem);
    background: var(--primary-deep);
    color: #fff;
  }
  .team-band__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .team-band h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-body);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .team-band h2 span {
    color: var(--sky);
    font-weight: 600;
  }
  .team-band__more {
    color: var(--sky);
    font-weight: 600;
    text-decoration: none;
  }
  .team-band__more:hover {
    text-decoration: underline;
  }

  .slider {
    position: relative;
  }
  .slider__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2 * 2rem) / 3);
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .slider__track::-webkit-scrollbar {
    display: none;
  }
  .slider__arrow {
    position: absolute;
    /* sredina fotografije (visinu fotografije postavlja skripta) */
    top: var(--arrow-top, 40%);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    background: var(--primary);
    color: #fff;
    cursor: pointer;
    transform: translateY(-50%);
  }
  .slider__arrow[hidden] {
    display: none;
  }
  .slider__arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .slider__arrow:not(:disabled):hover {
    background: var(--primary-deep);
    outline: 1px solid var(--sky);
  }
  .slider__arrow svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .slider__arrow--prev {
    left: 0;
  }
  .slider__arrow--next {
    right: 0;
  }

  .doc {
    scroll-snap-align: start;
  }
  .doc__photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    background: #fff;
  }
  .doc__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }
  /* Plava traka sa telefonom: pojavljuje se pri prelasku mišem (na telefonu je uvek tu kao mali krug) */
  .doc__call {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    place-items: center;
    height: 27%;
    background: rgb(91 172 222 / 0.92);
    opacity: 0;
    transform: translateY(100%);
    transition:
      opacity 0.25s,
      transform 0.25s;
  }
  .doc:hover .doc__call,
  .doc__call:focus-visible {
    opacity: 1;
    transform: none;
  }
  .doc__call:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -3px;
  }
  .doc__call-icon {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    color: var(--primary);
  }
  .doc__call-icon svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: currentColor;
  }
  .doc__name {
    margin: 1.4rem 0 0.3rem;
    color: #fff;
    font-family: var(--font-body);
    font-size: 1.35rem;
    font-weight: 600;
    transition: color 0.2s;
  }
  .doc:hover .doc__name {
    color: var(--sky);
  }
  .doc__role {
    margin: 0 0 0.3rem;
    color: #fff;
    font-size: 1.05rem;
  }
  .doc__focus {
    margin: 0;
    color: rgb(255 255 255 / 0.72);
    font-size: 0.95rem;
  }

  @media (hover: none) {
    .doc__call {
      inset: auto 0.75rem 0.75rem auto;
      width: auto;
      height: auto;
      background: none;
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 900px) {
    .slider__track {
      grid-auto-columns: calc((100% - 1.5rem) / 2);
      gap: 1.5rem;
    }
  }
  @media (max-width: 600px) {
    .slider__track {
      grid-auto-columns: 85%;
      gap: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .doc__call,
    .doc__name {
      transition: none;
    }
  }
</style>
